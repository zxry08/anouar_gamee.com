/* style.css — neon design, host left, question box right, animated bg */
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap');

:root{
  --neon-pink: #ff2bd6;
  --neon-blue: #0ce3ff;
  --bg-dark1: #060018;
  --bg-dark2: #0b0033;
  --glass: rgba(255,255,255,0.03);
  --card-w: 520px;
  --card-h: 420px;
}

*{box-sizing:border-box}
html,body{height:100%;margin:0;font-family:'Cairo',sans-serif;background:#000;direction:rtl}

.screen{display:none;height:100vh;align-items:center;justify-content:center;padding:30px}
.screen.active{display:flex;flex-direction:column;align-items:center;justify-content:center}

/* START */
.big-title{
  font-size:54px;
  color:var(--neon-pink);
  text-shadow:0 0 18px rgba(255,43,214,0.85), 0 0 40px rgba(12,227,255,0.15);
  margin:10px 0 18px;
}
.start-controls{display:flex;gap:12px;margin-bottom:14px}
.lang-toggle{padding:10px 18px;border-radius:10px;background:transparent;border:2px solid rgba(12,227,255,0.12);color:var(--neon-blue);cursor:pointer;font-weight:600}
.lang-toggle.active{background:linear-gradient(90deg, rgba(12,227,255,0.08), rgba(255,43,214,0.05));color:#fff;box-shadow:0 8px 28px rgba(12,227,255,0.06)}
.level-buttons{display:flex;gap:16px;margin-bottom:10px}
.level-btn{padding:14px 26px;border-radius:12px;border:2px solid rgba(255,43,214,0.12);background:transparent;color:var(--neon-pink);font-weight:700;cursor:pointer;box-shadow:0 10px 30px rgba(255,43,214,0.03)}
.hint{color:#cfeaff;margin-top:10px}

/* GAME SCREEN layout */
.game-header{width:1000px;max-width:95%;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.game-title{font-size:28px;color:var(--neon-pink);text-shadow:0 0 12px rgba(255,43,214,0.85)}
.small-controls{display:flex;gap:8px}
.control-btn{padding:8px 12px;border-radius:8px;background:transparent;border:2px solid rgba(12,227,255,0.12);color:var(--neon-blue);cursor:pointer}
.level-indicator{color:#bfefff;font-weight:700;margin-bottom:6px}
.lang-indicator{display:flex;gap:6px}

/* animated neon background (azraq + rose) */
body::before, body::after{
  content:"";position:fixed;left:0;top:0;width:100%;height:100%;z-index:0;pointer-events:none;
}
body::before{
  background: radial-gradient(circle at 10% 10%, rgba(12,227,255,0.08), transparent 8%),
              radial-gradient(circle at 90% 20%, rgba(255,43,214,0.06), transparent 12%);
  mix-blend-mode:screen;filter:blur(30px);animation:moveBg 14s linear infinite;
}
body::after{
  background: linear-gradient(135deg,#05002b 0%, #120033 40%, #22003a 100%);
  z-index:-1;opacity:0.95;
}
@keyframes moveBg{0%{transform:translateY(0)}50%{transform:translateY(30px)}100%{transform:translateY(0)}}

/* main container */
.game-container{
  width:1000px;max-width:95%;height:520px;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.08));
  border-radius:20px;border:1px solid rgba(255,255,255,0.03);box-shadow:0 20px 60px rgba(2,6,23,0.8);position:relative;overflow:hidden;z-index:2;
  display:flex;flex-direction:row;align-items:stretch;padding:18px;
}

/* host left */
.host{width:40%;display:flex;align-items:flex-end;justify-content:flex-start;position:relative;padding-left:12px;z-index:1}
.host img{max-width:95%;height:auto;filter:drop-shadow(0 10px 30px rgba(12,227,255,0.12))}

/* question area right */
.question-area{width:60%;display:flex;flex-direction:column;align-items:flex-end;padding-right:18px;gap:12px}
.timer-wrap{display:flex;align-items:center;gap:12px;width:100%;justify-content:flex-end}
.timer-bar{width:280px;height:10px;background:rgba(255,255,255,0.06);border-radius:8px;overflow:hidden;border:1px solid rgba(12,227,255,0.06)}
.timer-fill{height:100%;width:100%;background:linear-gradient(90deg,var(--neon-blue),var(--neon-pink));transition:width 0.25s linear}
.timer-text{color:#bfefff;font-weight:700;text-shadow:0 0 8px rgba(12,227,255,0.2)}

/* question card visual */
.question-card{width:var(--card-w);height:var(--card-h);background:rgba(0,0,0,0.55);border-radius:16px;padding:18px;border:2px solid rgba(255,43,214,0.06);box-shadow:0 0 30px rgba(255,43,214,0.06);}
.question-text{font-size:22px;color:#eaf7ff;text-align:center;margin-bottom:16px;text-shadow:0 0 10px rgba(255,43,214,0.25)}
.answers{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.answers button{padding:12px;border-radius:10px;border:2px solid rgba(255,43,214,0.08);background:linear-gradient(90deg,rgba(255,255,255,0.02),transparent);color:var(--neon-pink);font-weight:700;cursor:pointer;box-shadow:0 8px 18px rgba(2,6,23,0.6);transition:transform .15s,box-shadow .15s}
.answers button:hover{transform:translateY(-4px);box-shadow:0 18px 30px rgba(12,227,255,0.07)}
/* correct/wrong visuals */
.answers button.correct{background:linear-gradient(90deg, rgba(0,255,120,0.16), rgba(0,255,120,0.06));border-color:rgba(0,255,120,0.5);color:#dfffe6;box-shadow:0 0 18px rgba(0,255,120,0.16)}
.answers button.wrong{background:linear-gradient(90deg, rgba(255,80,80,0.14), rgba(255,80,80,0.06));border-color:rgba(255,80,80,0.5);color:#ffeaea;box-shadow:0 0 18px rgba(255,80,80,0.12)}

/* progress + score */
.progress-row{display:flex;align-items:center;justify-content:space-between;margin-top:12px}
.q-progress{flex:1;height:10px;background:rgba(255,255,255,0.03);border-radius:10px;margin-left:12px;overflow:hidden}
.q-progress div{height:100%;width:0;background:linear-gradient(90deg, #4cff4c, #18ff9b);transition:width .4s linear}
.score-text{width:88px;text-align:center;color:#cfeaff;font-weight:700}

/* bottom */
.bottom-buttons{display:flex;gap:10px;position:absolute;bottom:18px;left:18px}
.control-btn{padding:8px 12px;border-radius:8px;background:transparent;border:2px solid rgba(12,227,255,0.12);color:var(--neon-blue);cursor:pointer}

/* end screen */
#endScreen .end-score{font-size:20px;color:#bfefff;margin:12px}
#endScreen .control-btn{margin:6px}

/* responsive small */
@media (max-width:1000px){
  .game-container{flex-direction:column;height:auto;padding:12px}
  .host{width:100%;justify-content:center}
  .question-area{width:100%;padding:8px}
  .question-card{width:100%;height:auto}
}
